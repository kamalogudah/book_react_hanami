<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book react</title>
    <%= favicon_tag %>
    <%= stylesheet_tag "app" %>
    <%= inertia_ssr_head(ssr_head) if ssr_head %>
  </head>
  <body>
    <% if ssr_body %>
      <%= inertia_ssr_body(ssr_body) %>
    <% else %>
      <%= inertia_root(page: page) %>
    <% end %>
    <%= javascript_tag "app" %>
  </body>
</html>
